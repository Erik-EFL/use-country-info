{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./dist",
    "rootDir": "./src"
  },
  "include": [
    "src/**/*",
    "src/@types"
  ],
  "exclude": [
    "node_modules",
    "mock",
    "test.config.js",
    "**/__tests__/**"
  ]
}
